VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: explicit OAuth callback target (used for signInWithOAuth redirectTo)
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/shot-db/
# Local Supabase GitHub OAuth (for `supabase start`)
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-oauth-app-client-secret

# Optional: for seed script (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for Supabase CLI (supabase db push, etc.)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# Dev modes:
#   npm run dev       → uses .env (local Supabase via `supabase start`)
#   npm run dev:prod  → uses .env.prod (production Supabase)
#
# For dev:prod OAuth to work, add http://localhost:5174/shot-db/
# (or your local port) to your Supabase project's allowed redirect URLs:
# Dashboard → Authentication → URL Configuration → Redirect URLs
